# ==============================================================================
# Graph-Based Financial Fraud Detection Using Neo4j
# Environment Variables Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT YOUR REAL .env FILE TO GITHUB
# ==============================================================================

# ------------------------------------------------------------------------------
# Neo4j Database Connection
# ------------------------------------------------------------------------------
# For Neo4j AuraDB Free (Cloud):
# URI Format: neo4j+s://<instance-id>.databases.neo4j.io
# Get free instance from https://console.neo4j.io
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-secure-aura-password
NEO4J_DATABASE=neo4j

# For Local Neo4j (Alternative / Fallback):
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password123
# NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# FastAPI Backend Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=*

# Detection Rule Thresholds
LARGE_TRANSACTION_THRESHOLD=10000.0
HIGH_VELOCITY_TX_COUNT=5
HIGH_VELOCITY_WINDOW_HOURS=24
SMURFING_SUB_THRESHOLD=10000.0
SMURFING_MIN_ACCOUNTS=3

# ------------------------------------------------------------------------------
# Streamlit Frontend Configuration
# ------------------------------------------------------------------------------
# Point to your deployed FastAPI backend URL on Render / Cloud
# E.g., https://neo4j-fraud-detection-api.onrender.com or http://localhost:8000 for local
BACKEND_API_URL=http://localhost:8000
